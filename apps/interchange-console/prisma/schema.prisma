// ─────────────────────────────────────────────────────────────────────────────
// The Interchange — Registry schema (Sprint 1).
//
// This database is the Registry: who the members are, what they may call, what
// every borrower has consented to, and what was actually asked. It holds NO
// borrower record and NO raw identifier. The only identity that ever reaches
// here is `subjectToken` — the output of the OPRF, which no participant can
// reverse (blueprint v2 §4.1).
//
// Two boundaries this schema exists to enforce:
//
//   1. CONSENT. Every call carries a consentRef. The Registry validates it —
//      exists, not expired, not revoked, and its scopes cover the operation —
//      before any member answers. No consentRef, no answer. There is no code
//      path that serves an unconsented query, because AuditEntry.outcome has
//      nowhere to record one as GRANTED without a Consent to point at.
//
//   2. MEMBERSHIP. The `.198` members are SEPARATE LEGAL ENTITIES sharing one
//      ServiceSuite database, partitioned only by EntityID. That makes
//      Member.sourceEntityId a security boundary between competitors, not a
//      query filter — a read that forgets it is a cross-member data leak. The
//      node scopes every read by it; the caller is never trusted to supply it.
//
// Postgres RLS lands in Sprint 2, following the pattern already proven in
// BirgenAI_LMS (prisma/rls.sql + src/lib/prisma.ts): app-level scoping is the
// promise, RLS is the guarantee, and this schema is shaped for both.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

// ── Members ──────────────────────────────────────────────────────────────────

enum MemberStatus {
  PROSPECT // identified, not yet onboarded
  SHADOW // contributing, MAY NOT query — the reciprocity apprenticeship
  ACTIVE // full member
  SUSPENDED // stopped contributing, or breached
}

/// A participating organisation. One row per LEGAL ENTITY, even when several
/// share a database — see the note on sourceEntityId.
model Member {
  id     String       @id @default(cuid())
  /// X-Road-compatible identifier: KE/LENDER/3005
  code   String       @unique
  name   String
  status MemberStatus @default(PROSPECT)

  joinedAt    DateTime?
  /// While set and in the future, this member contributes but cannot query.
  shadowUntil DateTime?

  // ── Identity ───────────────────────────────────────────────────────────────
  /// Ed25519 public key, hex. Every request this member makes is signed with
  /// the matching private key, which never leaves their node. This is what
  /// replaces "the caller told us who they are" — a claim any member could
  /// forge — with a claim only this member can make.
  publicKey       String?
  keyRegisteredAt DateTime?

  // ── Provenance ─────────────────────────────────────────────────────────────
  /// Where their book physically lives, e.g. "213.148.17.198,4420".
  sourceHost     String?
  sourceDatabase String?
  /// THE SECURITY BOUNDARY. Ten separate companies share the .198 Serviceconnect
  /// database, separated only by this column. Every read the node performs on
  /// their behalf must be scoped to it.
  sourceEntityId Int?

  // ── Contribution ───────────────────────────────────────────────────────────
  // Reciprocity is computed from these fields by the policy engine. It is not a
  // clause in an agreement — a member who stops contributing stops being able
  // to query, automatically.
  lastContributionAt DateTime?
  borrowers          Int       @default(0)
  loans              Int       @default(0)

  /// The MemberHolding generation currently being served for this member.
  ///
  /// 0 means this member has never published a book, which is NOT the same as
  /// "holds nothing" — /api/node/exposure must answer `unpublished` rather than
  /// `has_exposure: false`, or a member who has simply not been ingested yet
  /// would silently clear every borrower they lend to.
  holdingGeneration   Int       @default(0)
  holdingsPublishedAt DateTime?

  consents      Consent[]
  subscriptions Subscription[]
  callsMade     AuditEntry[]   @relation("caller")
  /// Every report this member has bought. The spine of the report store.
  pulls         ReportPull[]   @relation("pulls")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceHost, sourceDatabase, sourceEntityId])
  @@index([status])
}

// ── Services ─────────────────────────────────────────────────────────────────

enum ServiceKind {
  QUERY // brokered, real-time — Plane A
  REPORT // assembled CRB 2.0 artefact
}

/// Something a member can call. The Directory is this table.
model Service {
  id             String      @id @default(cuid())
  code           String      @unique
  name           String
  kind           ServiceKind
  /// CRB 2.0 report type, where this service is a report (1, 2, 3, 11, 12, 20…).
  reportType     Int?
  description    String
  /// Consent scopes a caller must hold before this service will answer.
  requiredScopes String[]
  /// False while a service is specified but not yet live.
  live           Boolean     @default(false)

  subscriptions Subscription[]
  audits        AuditEntry[]

  @@index([kind])
}

model Subscription {
  id             String  @id @default(cuid())
  memberId       String
  serviceId      String
  active         Boolean @default(true)
  /// Free calls per day. The commercial model is per-query ABOVE a
  /// contribution-linked free tier, so this is derived from contribution
  /// volume rather than negotiated per member.
  freeTierPerDay Int     @default(0)

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([memberId, serviceId])
}

// ── Consent ──────────────────────────────────────────────────────────────────

enum ConsentChannel {
  PWA // borrower self-served through the Micro-Eazy portal
  LMS_CONSOLE // captured by staff in the lending console
  MEMBER_API // a bridged member POSTed it from their own onboarding
  FIELD_OFFICER
}

enum ConsentEventKind {
  CAPTURED
  VALIDATED // a call presented this ref and it passed
  REFUSED_SCOPE // presented, but the scope did not cover the operation
  REFUSED_REVOKED // presented after the borrower withdrew
  REVOKED // the borrower withdrew
  EXPIRED
}

/// One borrower's standing permission. The evidence a regulator would ask for.
model Consent {
  id  String @id @default(cuid())
  /// The opaque handle callers quote. Not guessable, not meaningful.
  ref String @unique

  /// OPRF output. NEVER a national ID, NEVER an MSISDN. If a raw identifier can
  /// reach this column, the tokenisation boundary has been breached upstream.
  subjectToken String

  /// The member who captured it — the controller for this consent.
  memberId String

  scopes         String[]
  /// Which version of the wording they actually agreed to. Without this the
  /// consent is unprovable, because nobody can say what was on the screen.
  wordingVersion String
  capturedVia    ConsentChannel

  capturedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  /// Channel, device, IP, OTP reference — whatever proves an affirmative act.
  evidence Json?

  member Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  events ConsentEvent[]

  @@index([subjectToken])
  @@index([memberId])
  @@index([expiresAt])
}

model ConsentEvent {
  id            String           @id @default(cuid())
  consentId     String
  kind          ConsentEventKind
  at            DateTime         @default(now())
  /// Which member triggered this event, when it was not the capturing member.
  actorMemberId String?
  serviceCode   String?
  detail        String?

  consent Consent @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@index([consentId, at])
}

// ── Audit ────────────────────────────────────────────────────────────────────

enum CallOutcome {
  GRANTED
  REFUSED_NO_CONSENT
  REFUSED_SCOPE
  REFUSED_RECIPROCITY // caller is in SHADOW, or has stopped contributing
  REFUSED_QUOTA
  ERROR
}

/// Every call, answered or refused. This is what lets a member prove what they
/// did and did not send, and what lets a borrower be shown who asked about them.
model AuditEntry {
  id           String      @id @default(cuid())
  at           DateTime    @default(now())
  callerId     String
  serviceId    String
  subjectToken String
  consentRef   String?
  outcome      CallOutcome
  latencyMs    Int?
  /// How many member nodes actually answered a fan-out.
  respondents  Int?
  detail       String?

  caller  Member  @relation("caller", fields: [callerId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([subjectToken])
  @@index([at])
  @@index([callerId, at])
}

// ── Message log ──────────────────────────────────────────────────────────────

/// The append-only, hash-chained record of every exchange.
///
/// This is the component that makes non-repudiation real. Each entry carries
/// the hash of the one before it, so removing or editing any entry breaks every
/// hash after it — a member can prove what they sent, and just as importantly
/// can prove what they did NOT send, because a missing entry is detectable
/// rather than merely absent.
///
/// Entries are batch-timestamped against an RFC 3161 authority (blueprint v2
/// §4.2). Timestamping is asynchronous by design: the exchange does not block
/// on the TSA being reachable, but a chain that has gone un-timestamped for too
/// long is a fault worth alerting on.
model MessageLogEntry {
  /// Monotonic position in the chain. Assigned under a lock — the chain has one
  /// writer at a time or it is not a chain.
  seq BigInt   @id
  at  DateTime @default(now())

  /// Hash of the previous entry. The genesis entry carries 64 zeroes.
  prevHash String
  /// SHA-256 over prevHash + the canonical payload below.
  hash     String @unique

  callerCode   String
  serviceCode  String
  subjectToken String
  consentRef   String?
  outcome      String

  /// Digest of the request as received, and of the response as sent. The bodies
  /// themselves are NOT stored — the log proves what was exchanged without
  /// becoming a second copy of the data it is meant to protect.
  requestDigest  String
  responseDigest String?

  /// The caller's signature over the request digest.
  callerSignature String?

  /// Set when a batch is timestamped. Null means "not yet anchored".
  timestampedAt    DateTime?
  timestampBatchId String?

  @@index([at])
  @@index([callerCode, at])
  @@index([subjectToken])
  @@index([timestampedAt])
}

/// One row per OPRF evaluation REQUEST, so token issuance can be rate-limited.
///
/// This is the control that keeps the OPRF honest. The construction stops a
/// member computing tokens OFFLINE, but a member could still walk the national
/// ID space ONLINE by asking the Registry a hundred million times. Counting and
/// capping issuance is what closes that door.
///
/// `count` exists because a node ingesting its own book evaluates in BATCHES —
/// Axe's live entity carries fourteen thousand open loans, and one row per
/// element would write fourteen thousand rows to answer one request. The cap is
/// enforced on SUM(count), never on the row count, so batching cannot be used to
/// slip past it.
model OprfIssuance {
  id       String   @id @default(cuid())
  memberId String
  at       DateTime @default(now())
  /// Elements evaluated in this request.
  count    Int      @default(1)
  /// SERVING for a live decision, INGEST for a node tokenising its own book.
  ///
  /// The two are not the same risk and must not share one allowance. A serving
  /// call is about a borrower who is in front of somebody; an ingest walks a
  /// whole book, which is the shape an enumeration attack also has. Separating
  /// them means the serving cap can stay strict while ingest is granted
  /// deliberately, sized to a declared book, and visible in the audit.
  kind     String   @default("SERVING")

  @@index([memberId, at])
}

// ── Exposure ─────────────────────────────────────────────────────────────────

/// What one member currently holds against one borrower.
///
/// ⚠ This table is a STAND-IN. In the deployed architecture it does not exist:
/// a member's node answers exposure queries by reading their OWN Serviceconnect
/// book, scoped to their EntityID, and nothing about their borrowers is ever
/// centralised. It lives here so Sprint 3 can exercise the real fan-out path —
/// parallel HTTP, per-member timeouts, partial results, signed responses —
/// before nodes are deployed at members.
///
/// Keeping it keyed on subjectToken rather than a borrower id is deliberate:
/// even the stand-in cannot hold an identity.
model MemberHolding {
  id           String @id @default(cuid())
  memberId     String
  subjectToken String

  activeLoans       Int       @default(0)
  outstandingKes    Int       @default(0)
  /// Collections taxonomy, matching CollectBox LoanCategories.
  worstBucket       String    @default("due")
  newestDisbursedAt DateTime?

  /// Which publication these rows belong to.
  ///
  /// A node publishes its whole book in chunks — Axe's live entity is fourteen
  /// thousand rows — and the obvious implementation, "delete then insert", opens
  /// a window in which the member truthfully appears to hold NOTHING. An exposure
  /// query landing in that window returns "no exposure found" for a borrower who
  /// is three loans deep, which is the single most dangerous answer this service
  /// can give. So chunks are written under a NEW generation and become visible
  /// only when Member.holdingGeneration is advanced, in one statement, at the end.
  generation Int @default(1)

  updatedAt DateTime @updatedAt

  @@unique([memberId, subjectToken, generation])
  @@index([subjectToken])
  @@index([memberId, generation])
}

/// A member's published Bloom filter of active-borrower tokens.
///
/// This is not only a latency optimisation. Without it, every exposure query
/// broadcasts to all members that a named token is being evaluated — which
/// leaks a member's origination pipeline to its competitors. Screening locally
/// means most members never learn the query happened at all.
///
/// Filters are generational: a member publishes a new one every 15 minutes and
/// the old one stays readable until it is replaced, so a rebuild never leaves
/// the broker with nothing to screen against.
model MemberFilter {
  id         String   @id @default(cuid())
  memberId   String
  generation Int
  /// The bit array.
  bits       Bytes
  /// Number of hash functions, and bit length. Needed to interpret `bits`.
  k          Int
  m          Int
  itemCount  Int
  builtAt    DateTime @default(now())

  @@unique([memberId, generation])
  @@index([memberId, builtAt])
}

// ── Plane B: the learning loop ───────────────────────────────────────────────

/// A bitemporal ledger event. The substrate the feature store computes over.
///
/// TWO TIMESTAMPS, AND THE DIFFERENCE BETWEEN THEM IS THE WHOLE POINT:
///
///   `at`         when the thing HAPPENED (valid time)
///   `recordedAt` when the ecosystem LEARNED it (transaction time)
///
/// A naive feature store filters on `at <= asOf` and quietly leaks. Consider an
/// arrears event that occurred on day 5 but was only reported on day 20: a
/// vector computed as-of day 10 must NOT contain it, because on day 10 nobody
/// knew. Filtering on `at` alone includes it, the backtest looks superb, and the
/// model collapses in production — because at scoring time that fact does not
/// exist yet.
///
/// Late-arriving data is the norm in lending, not the exception. Members report
/// in batches, collections update days later, bureau data lags weeks. Any store
/// that is not bitemporal is silently training on the future.
model LedgerEvent {
  id           String @id @default(cuid())
  memberId     String
  subjectToken String

  at         DateTime
  recordedAt DateTime @default(now())

  /// DISBURSED · REPAYMENT · ARREARS · CLOSED · APPLICATION · DECLINE
  kind        String
  amountKes   Int?
  daysPastDue Int?

  @@index([subjectToken, recordedAt])
  @@index([subjectToken, at])
  @@index([memberId, recordedAt])
}

/// A credit decision, with the exact feature vector that produced it.
///
/// Written SYNCHRONOUSLY at decision time. This is not an optimisation — a
/// vector reconstructed later is a different vector, because the underlying
/// facts have since changed and late-arriving data has landed. If this row is
/// not written when the decision is made, that training example is not delayed,
/// it is GONE. The nightly backfill in emmanuel-arch/BirgenAI has been failing
/// since it was added, which is exactly this loss, repeated every night.
model Decision {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  memberId     String
  subjectToken String

  /// APPROVED · DECLINED
  outcome   String
  amountKes Int?

  /// The vector as it stood at `at`. Frozen, never recomputed.
  features          Json
  featureSetVersion String
  modelVersion      String
  score             Int?

  /// Set once the performance window closes.
  /// REPAID · DEFAULTED · IMMATURE
  label           String?
  labelledAt      DateTime?
  /// OWN_BOOK — we lent and observed the outcome ourselves.
  /// ECOSYSTEM — we DECLINED, another member lent, and we observed theirs.
  ///             This is reject inference with ground truth instead of a guess.
  labelSource     String?
  labelMemberCode String?

  @@index([memberId, at])
  @@index([subjectToken])
  @@index([label])
  @@index([outcome, label])
}

// ── Scoring ──────────────────────────────────────────────────────────────────

/// A trained model. Versioned, with the metrics it earned on held-out data.
///
/// Promotion is a status change on a row, not a deploy. That matters: a model
/// that can only be rolled back by shipping code will not be rolled back at
/// 2am when its reason codes start looking wrong.
model ModelVersion {
  id        String   @id @default(cuid())
  version   String   @unique
  algorithm String
  trainedAt DateTime @default(now())

  /// The feature set this was trained against. A model scored with a different
  /// feature set version is scoring on inputs it never saw.
  featureSetVersion String

  /// Learned parameters — coefficients, or the tree ensemble.
  params  Json
  /// AUC, KS, Gini, sample sizes, base rate.
  metrics Json

  /// CHAMPION — decides. CHALLENGER — shadow-scores only. RETIRED.
  status String @default("CHALLENGER")

  trainedOnRows Int
  trainStart    DateTime
  trainEnd      DateTime
  testStart     DateTime
  testEnd       DateTime

  shadowScores ShadowScore[]

  @@index([status])
}

/// A challenger's opinion on a decision the champion already made.
///
/// Challengers score live traffic without deciding anything. Promotion happens
/// only when a challenger beats the champion on a held-out window it has never
/// been trained on — never on backtest alone, because a backtest is a claim
/// about the past and a shadow score is a claim about now.
model ShadowScore {
  id             String   @id @default(cuid())
  decisionId     String
  modelVersionId String
  score          Int
  probability    Float
  at             DateTime @default(now())

  modelVersion ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)

  @@unique([decisionId, modelVersionId])
  @@index([modelVersionId])
}

// ── Onboarding & governance ──────────────────────────────────────────────────

/// A prospective member's application to join.
///
/// Self-service on purpose. The founding cohort was admitted by hand, which is
/// fine for three and impossible for thirty — and a network that only its
/// operator can add members to is not a network, it is a customer list.
model MemberApplication {
  id          String   @id @default(cuid())
  submittedAt DateTime @default(now())

  organisation   String
  contactName    String
  contactEmail   String
  /// Where their book lives, so the node can be placed.
  sourceHost     String?
  sourceDatabase String?
  sourceEntityId Int?

  /// Self-declared, verified during the shadow period against what they
  /// actually publish. A claim is not evidence.
  claimedBorrowers Int @default(0)
  claimedLoans     Int @default(0)

  /// Ed25519 public key, hex. Registered by signing the application WITH it,
  /// which proves possession of the private half rather than merely knowledge
  /// of a string someone could have copied.
  publicKey String?

  /// SUBMITTED · KEY_REGISTERED · ADMITTED · REJECTED · WITHDRAWN
  status       String    @default("SUBMITTED")
  decidedAt    DateTime?
  decidedBy    String?
  decisionNote String?

  /// Set when admission creates the Member row.
  memberId String?

  @@index([status, submittedAt])
}

/// An admission, suspension or readmission, and who decided it.
///
/// BirgenAI operates the Interchange while also selling lending software to some
/// members. A competitor will name that conflict in the first meeting, and the
/// answer cannot be "trust us" — it has to be a record of who decided what, on
/// what grounds, visible to every member.
model GovernanceAction {
  id            String   @id @default(cuid())
  at            DateTime @default(now())
  /// ADMIT · REJECT · SUSPEND · REINSTATE · PROMOTE_FROM_SHADOW
  action        String
  memberCode    String?
  applicationId String?
  /// The governing body member or operator who decided.
  decidedBy     String
  rationale     String

  @@index([at])
  @@index([memberCode])
}

// ── Operators ────────────────────────────────────────────────────────────────
//
// WHO IS SITTING AT THE CONSOLE, as distinct from WHICH MEMBER they act for.
//
// Sprint 1 conflated the two: a session cookie held a member code, and the gate
// granted it to anyone who typed four digits. That is two separate holes — the
// console had no notion of a person, and the cookie was an unsigned string a
// browser could simply set. Both are closed here.
//
// A SUPER_ADMIN has `memberId = null` on purpose. Every other operator is scoped
// to exactly one member and can never read across the boundary that
// Member.sourceEntityId exists to defend; the platform operator sits ABOVE that
// boundary, which is precisely why the role is separate and separately audited.
//
// ⚠ ACCESS CODES ARE LOW-ENTROPY BY DESIGN — the gate asks for four digits, so
// there are 10,000 of them. The hash is therefore not the control that matters:
// LOCKOUT is. See lib/operator.ts, which locks an operator after
// MAX_FAILED_ATTEMPTS and refuses code login entirely in production unless it
// has been explicitly, deliberately enabled.

enum OperatorRole {
  SUPER_ADMIN // BirgenAI platform operator — every right, above every member
  MEMBER_ADMIN // administers one member: keys, subscriptions, its own operators
  ANALYST // queries and reads on behalf of one member
  AUDITOR // read-only; audit, log and governance surfaces
}

enum OperatorStatus {
  ACTIVE
  DISABLED
}

/// A human who may open the console.
model Operator {
  id   String       @id @default(cuid())
  name String
  role OperatorRole @default(ANALYST)

  /// Null ⇒ platform operator, not scoped to any single member.
  memberId String?

  /// scrypt(code, codeSalt). The plaintext code is never stored, never logged
  /// and never returned by any route.
  codeHash String
  codeSalt String

  /// Grants BEYOND the role's defaults. "*" means every right there is and is
  /// only ever set on SUPER_ADMIN. See lib/rights.ts.
  rights String[] @default([])

  status OperatorStatus @default(ACTIVE)

  // ── Lockout — the control that actually protects a four-digit code ─────────
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([memberId])
}

/// Every console sign-in attempt, successful or not.
///
/// Separate from AuditEntry, which records EXCHANGE calls. Conflating "someone
/// opened the console" with "a member queried a borrower" would make both
/// harder to read, and only one of them is a data-protection event.
model OperatorAudit {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  operatorId String?
  /// SIGN_IN · SIGN_IN_REFUSED · LOCKED · SIGN_OUT · CODE_ROTATED · CREATED
  action     String
  /// Never the code, never a hash of it — just why it failed.
  detail     String?
  ip         String?

  @@index([at])
  @@index([operatorId, at])
}

/// How one member's M-PESA statements are read.
///
/// ── WHY THIS IS A TABLE AND NOT A CONSTANT ──────────────────────────────────
/// "Average monthly income" and "what they can afford" are not facts; they are
/// four defensible definitions apiece, and the choice moves the answer by a
/// factor of two. A microfinance lender writing working capital to traders reads
/// turnover; a salary-advance lender reads classified income. Both are right for
/// their own book, and the lender carrying the loss is the one entitled to
/// decide. See lib/statement/policy.ts for the shape.
///
/// ── WHY THE WHOLE POLICY IS ONE JSON COLUMN ─────────────────────────────────
/// Because it is read as a unit, written as a unit and, above all, PRINTED as a
/// unit: every Cashflow & Affordability report reproduces the settings it was
/// produced on, so a number can be defended a year later. Normalising twelve
/// score weights into rows would buy queries nobody runs and cost the one
/// guarantee that matters — that the settings stored are exactly the settings
/// the document shows. `normalisePolicy()` validates and clamps on the way in,
/// so an unknown or out-of-range value can never reach a report.
model MemberPolicy {
  id String @id @default(cuid())

  /// The member's X-Road code, e.g. KE/LENDER/3002. "default" is the
  /// Interchange's own, which every member starts from.
  memberCode String @unique

  /// What this member calls it, printed on every report they produce.
  label String

  /// A CrunchPolicy, validated by normalisePolicy() before it is written.
  settings Json

  /// Who changed it last. Printed on the report's method page beside the date,
  /// because "the system said so" is not an answer a credit committee accepts.
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// THE REPORT STORE — every pull, kept, so the same file is never bought twice.
//
// ── THE PROBLEM, AS IT ARRIVED ───────────────────────────────────────────────
// A member pressed "Request CRB report", the Registry routed the pull, Metropol
// answered, the document was rendered and streamed — and then the answer was
// gone. Nothing on this side held it. The LMS kept a copy against its own
// borrower row, which works for exactly one member and exactly one report type,
// and means the second officer to open the same customer that afternoon buys
// the same bytes again. Worse: an affordability report assembled from a crunched
// statement could only ever be looked at once, because the features it was built
// from lived in the request that produced it.
//
// ── THE SHAPE, AND WHY IT IS NOT ONE TABLE PER REPORT NUMBER ─────────────────
// The instinct was `MetropolReport8`, `MetropolReport11`, one table per number.
// Postgres would allow it — an identifier may contain digits, it just may not
// START with one — and Prisma would too. It is still the wrong cut, for three
// reasons that all bite later rather than now:
//
//   1. THE NUMBER IS METROPOL'S, NOT OURS. The Interchange publishes types
//      1/3/8/11/12 aligned with the bureau's numbering because that is the
//      cheapest migration path for a member already integrated with them — but
//      20, 21, 22 and 23 are ECOSYSTEM-NATIVE and have no bureau behind them at
//      all. A table named `MetropolReport20` would be a false statement about
//      where its rows came from, printed into the schema.
//
//   2. THE BUREAU RENUMBERS. Report 12 is already a composite of 12, 8, 11 and
//      16 (see lib/reports/catalogue.ts). A table per number makes that one row
//      in four tables, and the day Metropol splits or merges a product the
//      migration is a rename rather than a mapping.
//
//   3. HALF OF EVERY REPORT IS THE SAME HALF. Who asked, under which consent,
//      what it cost, which log entry proves it, when it expires. Repeating those
//      eleven columns across eight tables means eight places to fix a retention
//      bug, and no way to ask "what did we spend on this borrower this month"
//      without a union.
//
// So: a SPINE and FACETS.
//
//   ReportPull        one row per pull, of any type, holding the receipt: who,
//                     when, under what consent, what it cost, and the VERBATIM
//                     wire payload. This is the record of record.
//
//   ReportCreditFile  the facet for a bureau credit file (8, 12), with the data
//   ReportCreditLine  points a human or a model actually queries as columns,
//                     and one row per account line beside it.
//
//   ReportCashflow    the facet for the affordability read (11) — the crunched
//   ReportCashflowMonth  features, and the monthly series under them.
//
//   ReportIdentity    the facet for an identity verification (1).
//   ReportExposure    the facet for an ecosystem exposure answer (20).
//
// A facet is 1:1 with its pull and OPTIONAL. Nothing is lost when a new report
// type arrives before its facet is written: the spine still holds the verbatim
// answer, so the facet can be backfilled from stored rows rather than re-bought.
//
// ── WHAT IS DELIBERATELY NOT HERE ────────────────────────────────────────────
// No national ID, no name, no phone number. The subject is `subjectToken` and
// nothing else, exactly as in Consent and AuditEntry — the OPRF boundary does
// not become negotiable because a table is convenient. A facet column that would
// have required un-tokenising the subject is not a column, it is a bug.
//
// The rendered PDF is not stored either. It is deterministic from the wire
// payload and the renderer, and a base64 document per pull would multiply the
// size of this table by fifty to save a second of render time.
// ─────────────────────────────────────────────────────────────────────────────

/// How a stored pull was obtained — printed on the document, so a replayed
/// answer can never be mistaken for a fresh one.
enum PullSource {
  /// A live, billed call to the contract holder's bureau node.
  BUREAU
  /// Served from this store, inside its retention window. Not billed again.
  STORED
  /// A captured response replayed for a demo or a test. NEVER billed, and the
  /// document says so on its face.
  REPLAY
  /// Computed by the Registry from data the caller supplied (exposure, cashflow).
  DERIVED
}

/// One pull. The receipt, the retention clock, and the answer as it was given.
model ReportPull {
  id String @id @default(cuid())

  /// OPRF output. NEVER a national ID. See the note at the top of this file.
  subjectToken String
  /// The member who asked, and the code as it was at the time.
  callerId     String
  callerCode   String

  /// The Interchange report type (catalogue.ts), not the bureau's report number
  /// — which is recorded in `bureauReports` where the two differ.
  reportType    Int
  /// The bureau report numbers that actually went into this answer. Empty for
  /// an ecosystem-native type.
  bureauReports Int[]

  /// The consent that made it lawful. Nullable only because a REPLAY has none.
  consentRef String?

  source      PullSource @default(BUREAU)
  /// What the caller was charged, in pulls. Zero for a STORED re-serve, which
  /// is the whole point of this table.
  billedPulls Int        @default(0)
  latencyMs   Int?

  /// The message-log entry that proves this exchange happened. A pull with no
  /// receipt is a pull nobody can be held to.
  logSeq  BigInt?
  logHash String?

  /// THE ANSWER, VERBATIM. A bureau response means the bureau's own body,
  /// byte for byte, keyed by report number — not a restructured version of it.
  /// Everything in every facet below is derived from this and can be rebuilt.
  wire Json

  /// The normalised BureauFile / exposure aggregate, as the renderer consumed
  /// it. Kept beside the wire so a document can be re-rendered without re-running
  /// a normaliser that may since have changed its mind about an edge case.
  normalised Json?

  /// Metropol's transaction ids, where the bureau gave any. The thing a member
  /// quotes when they dispute a file with the bureau directly.
  trxIds String[]

  pulledAt  DateTime  @default(now())
  /// When this answer stops being servable and becomes eligible for purge.
  /// Derived from the member's retention policy at the moment of the pull, not
  /// read at query time — shortening a policy must not retroactively invalidate
  /// receipts already issued.
  expiresAt DateTime
  /// Set by the purge job. The row survives with its wire cleared, because the
  /// RECEIPT is a permanent record even when the personal data behind it is not.
  purgedAt  DateTime?

  caller Member @relation("pulls", fields: [callerId], references: [id], onDelete: Cascade)

  creditFile ReportCreditFile?
  cashflow   ReportCashflow?
  identity   ReportIdentity?
  exposure   ReportExposure?

  /// The lookup that makes a re-serve possible: this subject, this type, newest
  /// first, still inside retention.
  @@index([subjectToken, reportType, pulledAt])
  @@index([callerId, pulledAt])
  @@index([expiresAt])
  @@index([logSeq])
}

/// A bureau credit file (Interchange types 8 and 12), flattened to the numbers
/// people ask questions about.
model ReportCreditFile {
  pullId String @id

  /// Metropol's score and its own banding, as given. Null on a thin file, which
  /// is an ANSWER and not a failure.
  score     Int?
  scoreAsAt DateTime?
  scoreBand String?
  /// Probability of default, where the bureau expresses one.
  ppiValue  Float?
  ppiRank   String?

  delinquencyCode  String?
  delinquencyLabel String?

  /// Account counts, so "how exposed is this person" is one row and not a join.
  accountsTotal   Int @default(0)
  accountsLive    Int @default(0)
  accountsClosed  Int @default(0)
  accountsAdverse Int @default(0)

  outstanding      Decimal @default(0) @db.Decimal(18, 2)
  overdue          Decimal @default(0) @db.Decimal(18, 2)
  worstArrears     Int     @default(0)
  worstArrearsEver Int     @default(0)

  enquiries3       Int?
  enquiries6       Int?
  enquiries12      Int?
  applications3    Int?
  applications6    Int?
  applications12   Int?
  bouncedCheques12 Int?

  /// The bureau's own estimate of income, where it gives one. Not ours, and
  /// never mixed with the cashflow read — they disagree, and which one a lender
  /// trusted has to stay answerable.
  estimatedIncome Decimal? @db.Decimal(18, 2)

  hasFraud    Boolean?
  isGuarantor Boolean?

  /// Freshness of the bureau's own data, in days. A file assembled from a
  /// three-month-old submission is a different fact from a current one, and the
  /// difference is invisible unless it is stored.
  freshestReportDays Int?
  stalestReportDays  Int?

  pull  ReportPull         @relation(fields: [pullId], references: [id], onDelete: Cascade)
  lines ReportCreditLine[]
}

/// One account line on a credit file. Its own table because "the accounts" is
/// what every question is really about — who else is lent to, how much, how
/// late — and a JSON array cannot answer any of them without reading all of it.
model ReportCreditLine {
  id     String @id @default(cuid())
  fileId String

  /// The bureau's account reference, as given. Not a key here: two bureaux may
  /// reuse a string, and it is the lender's identifier, not ours.
  accountNumber String
  /// The lending institution, resolved through the CBK glossary where possible.
  institution   String?
  product       String?
  productTypeId Int?
  status        String

  openedAt DateTime?
  loadedAt DateTime?

  originalAmount Decimal @default(0) @db.Decimal(18, 2)
  currentBalance Decimal @default(0) @db.Decimal(18, 2)
  overdueBalance Decimal @default(0) @db.Decimal(18, 2)

  daysInArrears        Int @default(0)
  highestDaysInArrears Int @default(0)

  lastPaymentAmount Decimal?  @db.Decimal(18, 2)
  lastPaymentDate   DateTime?
  overdueDate       DateTime?
  delinquencyCode   String?

  /// True when this line is the CALLING member's own lending, which is how a
  /// report distinguishes "what we already knew" from "what the market knows".
  isOwn            Boolean @default(false)
  isLive           Boolean @default(false)
  isOpenButSettled Boolean @default(false)
  isAdverse        Boolean @default(false)

  file ReportCreditFile @relation(fields: [fileId], references: [pullId], onDelete: Cascade)

  @@index([fileId])
  @@index([institution])
}

/// The affordability read (type 11) — the crunched statement, kept.
///
/// This is the facet the founder asked for by name: income volatility, cash
/// inflows, betting share, expenditure. They were computed, rendered into a
/// document and thrown away, so the answer to "what did this customer's file
/// look like when we lent to them" was "we would have to ask them for the
/// statement again". Every column here is a feature the decision engine reads,
/// stored in the shape it reads it, so an affordability report is available at
/// any time without re-crunching anything.
model ReportCashflow {
  pullId String @id

  /// The window the statement actually covered — not the window requested.
  periodStart   DateTime?
  periodEnd     DateTime?
  monthsCovered Float     @default(0)
  txnCount      Int       @default(0)

  totalIncome       Decimal @default(0) @db.Decimal(18, 2)
  avgMonthlyIncome  Decimal @default(0) @db.Decimal(18, 2)
  totalExpense      Decimal @default(0) @db.Decimal(18, 2)
  avgMonthlyExpense Decimal @default(0) @db.Decimal(18, 2)
  avgMonthlyNet     Decimal @default(0) @db.Decimal(18, 2)
  /// Coefficient of variation of monthly income. 0 = perfectly stable.
  incomeVolatility  Float   @default(0)

  avgBalance     Decimal @default(0) @db.Decimal(18, 2)
  minBalance     Decimal @default(0) @db.Decimal(18, 2)
  closingBalance Decimal @default(0) @db.Decimal(18, 2)
  balanceTrend   Decimal @default(0) @db.Decimal(18, 2)

  /// Months with any income ÷ months covered. The "do they earn every month"
  /// question, which volatility alone does not answer.
  incomeMonthsRatio   Float @default(0)
  businessInflowCount Int   @default(0)
  tillPaybillCount    Int   @default(0)

  gamblingOutflow Decimal @default(0) @db.Decimal(18, 2)
  /// Betting as a share of gross outflow. A haircut trigger in every policy.
  gamblingRatio   Float   @default(0)

  loanInflow          Decimal @default(0) @db.Decimal(18, 2)
  loanRepayOutflow    Decimal @default(0) @db.Decimal(18, 2)
  loanEventCount      Int     @default(0)
  /// Borrowed ÷ (earned + borrowed). How much of their life is already credit.
  loanDependencyRatio Float   @default(0)
  airtimeSpend        Decimal @default(0) @db.Decimal(18, 2)

  /// The verdict, and the policy it was reached under. Both, because a score
  /// without the policy that produced it cannot be reproduced or defended.
  score                     Int?
  band                      String?
  recommendedMaxInstallment Decimal? @db.Decimal(18, 2)
  policyCode                String?
  policyLabel               String?
  /// The reason codes shown to the customer, in the order they were shown.
  reasons                   Json?

  pull   ReportPull            @relation(fields: [pullId], references: [id], onDelete: Cascade)
  months ReportCashflowMonth[]
}

/// The monthly series behind a cashflow read. A chart is a query, not a blob.
model ReportCashflowMonth {
  id         String @id @default(cuid())
  cashflowId String

  /// YYYY-MM, as the cruncher emits it.
  month    String
  income   Decimal @default(0) @db.Decimal(18, 2)
  expense  Decimal @default(0) @db.Decimal(18, 2)
  net      Decimal @default(0) @db.Decimal(18, 2)
  gambling Decimal @default(0) @db.Decimal(18, 2)

  cashflow ReportCashflow @relation(fields: [cashflowId], references: [pullId], onDelete: Cascade)

  @@unique([cashflowId, month])
  @@index([cashflowId])
}

/// An identity verification (type 1). Thin on purpose: the point of this report
/// is a yes or a no and the evidence behind it, and storing the claimed name
/// beside a token would undo the tokenisation.
model ReportIdentity {
  pullId String @id

  matched     Boolean
  /// Which registry answered, and whether it was live. A simulated match that
  /// is not recorded as simulated is the single most dangerous row this schema
  /// could hold — see the KYC OCR note in the LMS.
  registry    String?
  simulated   Boolean  @default(false)
  /// Field-level agreement, where the registry reports it.
  nameMatch   Float?
  dobMatch    Boolean?
  genderMatch Boolean?

  pull ReportPull @relation(fields: [pullId], references: [id], onDelete: Cascade)
}

/// An ecosystem exposure answer (type 20). The aggregate the caller's own node
/// brokered, kept so the same question inside retention is free.
model ReportExposure {
  pullId String @id

  activeLoans        Int       @default(0)
  lenders            Int       @default(0)
  outstandingBand    String?
  worstBucket        String?
  newestDisbursement DateTime?
  velocity14d        Int       @default(0)

  /// How complete the answer was. A partial fan-out is a different fact from a
  /// clean one and must not be stored as if it were the same.
  partial   Boolean @default(false)
  screened  Int     @default(0)
  queried   Int     @default(0)
  responded Int     @default(0)
  /// Members that did not answer, and why. Nullable rather than empty: "nobody
  /// was silent" and "we did not record who was" are different.
  silent    Json?

  pull ReportPull @relation(fields: [pullId], references: [id], onDelete: Cascade)
}
