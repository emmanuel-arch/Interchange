// ─────────────────────────────────────────────────────────────────────────────
// The Interchange — Registry schema (Sprint 1).
//
// This database is the Registry: who the members are, what they may call, what
// every borrower has consented to, and what was actually asked. It holds NO
// borrower record and NO raw identifier. The only identity that ever reaches
// here is `subjectToken` — the output of the OPRF, which no participant can
// reverse (blueprint v2 §4.1).
//
// Two boundaries this schema exists to enforce:
//
//   1. CONSENT. Every call carries a consentRef. The Registry validates it —
//      exists, not expired, not revoked, and its scopes cover the operation —
//      before any member answers. No consentRef, no answer. There is no code
//      path that serves an unconsented query, because AuditEntry.outcome has
//      nowhere to record one as GRANTED without a Consent to point at.
//
//   2. MEMBERSHIP. The `.198` members are SEPARATE LEGAL ENTITIES sharing one
//      ServiceSuite database, partitioned only by EntityID. That makes
//      Member.sourceEntityId a security boundary between competitors, not a
//      query filter — a read that forgets it is a cross-member data leak. The
//      node scopes every read by it; the caller is never trusted to supply it.
//
// Postgres RLS lands in Sprint 2, following the pattern already proven in
// BirgenAI_LMS (prisma/rls.sql + src/lib/prisma.ts): app-level scoping is the
// promise, RLS is the guarantee, and this schema is shaped for both.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

// ── Members ──────────────────────────────────────────────────────────────────

enum MemberStatus {
  PROSPECT // identified, not yet onboarded
  SHADOW // contributing, MAY NOT query — the reciprocity apprenticeship
  ACTIVE // full member
  SUSPENDED // stopped contributing, or breached
}

/// A participating organisation. One row per LEGAL ENTITY, even when several
/// share a database — see the note on sourceEntityId.
model Member {
  id     String       @id @default(cuid())
  /// X-Road-compatible identifier: KE/LENDER/3005
  code   String       @unique
  name   String
  status MemberStatus @default(PROSPECT)

  joinedAt    DateTime?
  /// While set and in the future, this member contributes but cannot query.
  shadowUntil DateTime?

  // ── Identity ───────────────────────────────────────────────────────────────
  /// Ed25519 public key, hex. Every request this member makes is signed with
  /// the matching private key, which never leaves their node. This is what
  /// replaces "the caller told us who they are" — a claim any member could
  /// forge — with a claim only this member can make.
  publicKey       String?
  keyRegisteredAt DateTime?

  // ── Provenance ─────────────────────────────────────────────────────────────
  /// Where their book physically lives, e.g. "213.148.17.198,4420".
  sourceHost     String?
  sourceDatabase String?
  /// THE SECURITY BOUNDARY. Ten separate companies share the .198 Serviceconnect
  /// database, separated only by this column. Every read the node performs on
  /// their behalf must be scoped to it.
  sourceEntityId Int?

  // ── Contribution ───────────────────────────────────────────────────────────
  // Reciprocity is computed from these fields by the policy engine. It is not a
  // clause in an agreement — a member who stops contributing stops being able
  // to query, automatically.
  lastContributionAt DateTime?
  borrowers          Int       @default(0)
  loans              Int       @default(0)

  consents      Consent[]
  subscriptions Subscription[]
  callsMade     AuditEntry[]   @relation("caller")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceHost, sourceDatabase, sourceEntityId])
  @@index([status])
}

// ── Services ─────────────────────────────────────────────────────────────────

enum ServiceKind {
  QUERY // brokered, real-time — Plane A
  REPORT // assembled CRB 2.0 artefact
}

/// Something a member can call. The Directory is this table.
model Service {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  kind        ServiceKind
  /// CRB 2.0 report type, where this service is a report (1, 2, 3, 11, 12, 20…).
  reportType  Int?
  description String
  /// Consent scopes a caller must hold before this service will answer.
  requiredScopes String[]
  /// False while a service is specified but not yet live.
  live        Boolean     @default(false)

  subscriptions Subscription[]
  audits        AuditEntry[]

  @@index([kind])
}

model Subscription {
  id        String  @id @default(cuid())
  memberId  String
  serviceId String
  active    Boolean @default(true)
  /// Free calls per day. The commercial model is per-query ABOVE a
  /// contribution-linked free tier, so this is derived from contribution
  /// volume rather than negotiated per member.
  freeTierPerDay Int @default(0)

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([memberId, serviceId])
}

// ── Consent ──────────────────────────────────────────────────────────────────

enum ConsentChannel {
  PWA // borrower self-served through the Micro-Eazy portal
  LMS_CONSOLE // captured by staff in the lending console
  MEMBER_API // a bridged member POSTed it from their own onboarding
  FIELD_OFFICER
}

enum ConsentEventKind {
  CAPTURED
  VALIDATED // a call presented this ref and it passed
  REFUSED_SCOPE // presented, but the scope did not cover the operation
  REFUSED_REVOKED // presented after the borrower withdrew
  REVOKED // the borrower withdrew
  EXPIRED
}

/// One borrower's standing permission. The evidence a regulator would ask for.
model Consent {
  id  String @id @default(cuid())
  /// The opaque handle callers quote. Not guessable, not meaningful.
  ref String @unique

  /// OPRF output. NEVER a national ID, NEVER an MSISDN. If a raw identifier can
  /// reach this column, the tokenisation boundary has been breached upstream.
  subjectToken String

  /// The member who captured it — the controller for this consent.
  memberId String

  scopes         String[]
  /// Which version of the wording they actually agreed to. Without this the
  /// consent is unprovable, because nobody can say what was on the screen.
  wordingVersion String
  capturedVia    ConsentChannel

  capturedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  /// Channel, device, IP, OTP reference — whatever proves an affirmative act.
  evidence Json?

  member Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  events ConsentEvent[]

  @@index([subjectToken])
  @@index([memberId])
  @@index([expiresAt])
}

model ConsentEvent {
  id            String           @id @default(cuid())
  consentId     String
  kind          ConsentEventKind
  at            DateTime         @default(now())
  /// Which member triggered this event, when it was not the capturing member.
  actorMemberId String?
  serviceCode   String?
  detail        String?

  consent Consent @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@index([consentId, at])
}

// ── Audit ────────────────────────────────────────────────────────────────────

enum CallOutcome {
  GRANTED
  REFUSED_NO_CONSENT
  REFUSED_SCOPE
  REFUSED_RECIPROCITY // caller is in SHADOW, or has stopped contributing
  REFUSED_QUOTA
  ERROR
}

/// Every call, answered or refused. This is what lets a member prove what they
/// did and did not send, and what lets a borrower be shown who asked about them.
model AuditEntry {
  id           String      @id @default(cuid())
  at           DateTime    @default(now())
  callerId     String
  serviceId    String
  subjectToken String
  consentRef   String?
  outcome      CallOutcome
  latencyMs    Int?
  /// How many member nodes actually answered a fan-out.
  respondents  Int?
  detail       String?

  caller  Member  @relation("caller", fields: [callerId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([subjectToken])
  @@index([at])
  @@index([callerId, at])
}

// ── Message log ──────────────────────────────────────────────────────────────

/// The append-only, hash-chained record of every exchange.
///
/// This is the component that makes non-repudiation real. Each entry carries
/// the hash of the one before it, so removing or editing any entry breaks every
/// hash after it — a member can prove what they sent, and just as importantly
/// can prove what they did NOT send, because a missing entry is detectable
/// rather than merely absent.
///
/// Entries are batch-timestamped against an RFC 3161 authority (blueprint v2
/// §4.2). Timestamping is asynchronous by design: the exchange does not block
/// on the TSA being reachable, but a chain that has gone un-timestamped for too
/// long is a fault worth alerting on.
model MessageLogEntry {
  /// Monotonic position in the chain. Assigned under a lock — the chain has one
  /// writer at a time or it is not a chain.
  seq      BigInt   @id
  at       DateTime @default(now())

  /// Hash of the previous entry. The genesis entry carries 64 zeroes.
  prevHash String
  /// SHA-256 over prevHash + the canonical payload below.
  hash     String   @unique

  callerCode   String
  serviceCode  String
  subjectToken String
  consentRef   String?
  outcome      String

  /// Digest of the request as received, and of the response as sent. The bodies
  /// themselves are NOT stored — the log proves what was exchanged without
  /// becoming a second copy of the data it is meant to protect.
  requestDigest  String
  responseDigest String?

  /// The caller's signature over the request digest.
  callerSignature String?

  /// Set when a batch is timestamped. Null means "not yet anchored".
  timestampedAt    DateTime?
  timestampBatchId String?

  @@index([at])
  @@index([callerCode, at])
  @@index([subjectToken])
  @@index([timestampedAt])
}

/// One row per OPRF evaluation, so token issuance can be rate-limited.
///
/// This is the control that keeps the OPRF honest. The construction stops a
/// member computing tokens OFFLINE, but a member could still walk the national
/// ID space ONLINE by asking the Registry a hundred million times. Counting and
/// capping issuance is what closes that door.
model OprfIssuance {
  id       String   @id @default(cuid())
  memberId String
  at       DateTime @default(now())

  @@index([memberId, at])
}

// ── Exposure ─────────────────────────────────────────────────────────────────

/// What one member currently holds against one borrower.
///
/// ⚠ This table is a STAND-IN. In the deployed architecture it does not exist:
/// a member's node answers exposure queries by reading their OWN Serviceconnect
/// book, scoped to their EntityID, and nothing about their borrowers is ever
/// centralised. It lives here so Sprint 3 can exercise the real fan-out path —
/// parallel HTTP, per-member timeouts, partial results, signed responses —
/// before nodes are deployed at members.
///
/// Keeping it keyed on subjectToken rather than a borrower id is deliberate:
/// even the stand-in cannot hold an identity.
model MemberHolding {
  id           String @id @default(cuid())
  memberId     String
  subjectToken String

  activeLoans       Int      @default(0)
  outstandingKes    Int      @default(0)
  /// Collections taxonomy, matching CollectBox LoanCategories.
  worstBucket       String   @default("due")
  newestDisbursedAt DateTime?

  updatedAt DateTime @updatedAt

  @@unique([memberId, subjectToken])
  @@index([subjectToken])
}

/// A member's published Bloom filter of active-borrower tokens.
///
/// This is not only a latency optimisation. Without it, every exposure query
/// broadcasts to all members that a named token is being evaluated — which
/// leaks a member's origination pipeline to its competitors. Screening locally
/// means most members never learn the query happened at all.
///
/// Filters are generational: a member publishes a new one every 15 minutes and
/// the old one stays readable until it is replaced, so a rebuild never leaves
/// the broker with nothing to screen against.
model MemberFilter {
  id         String   @id @default(cuid())
  memberId   String
  generation Int
  /// The bit array.
  bits       Bytes
  /// Number of hash functions, and bit length. Needed to interpret `bits`.
  k          Int
  m          Int
  itemCount  Int
  builtAt    DateTime @default(now())

  @@unique([memberId, generation])
  @@index([memberId, builtAt])
}

// ── Plane B: the learning loop ───────────────────────────────────────────────

/// A bitemporal ledger event. The substrate the feature store computes over.
///
/// TWO TIMESTAMPS, AND THE DIFFERENCE BETWEEN THEM IS THE WHOLE POINT:
///
///   `at`         when the thing HAPPENED (valid time)
///   `recordedAt` when the ecosystem LEARNED it (transaction time)
///
/// A naive feature store filters on `at <= asOf` and quietly leaks. Consider an
/// arrears event that occurred on day 5 but was only reported on day 20: a
/// vector computed as-of day 10 must NOT contain it, because on day 10 nobody
/// knew. Filtering on `at` alone includes it, the backtest looks superb, and the
/// model collapses in production — because at scoring time that fact does not
/// exist yet.
///
/// Late-arriving data is the norm in lending, not the exception. Members report
/// in batches, collections update days later, bureau data lags weeks. Any store
/// that is not bitemporal is silently training on the future.
model LedgerEvent {
  id           String   @id @default(cuid())
  memberId     String
  subjectToken String

  at         DateTime
  recordedAt DateTime @default(now())

  /// DISBURSED · REPAYMENT · ARREARS · CLOSED · APPLICATION · DECLINE
  kind        String
  amountKes   Int?
  daysPastDue Int?

  @@index([subjectToken, recordedAt])
  @@index([subjectToken, at])
  @@index([memberId, recordedAt])
}

/// A credit decision, with the exact feature vector that produced it.
///
/// Written SYNCHRONOUSLY at decision time. This is not an optimisation — a
/// vector reconstructed later is a different vector, because the underlying
/// facts have since changed and late-arriving data has landed. If this row is
/// not written when the decision is made, that training example is not delayed,
/// it is GONE. The nightly backfill in emmanuel-arch/BirgenAI has been failing
/// since it was added, which is exactly this loss, repeated every night.
model Decision {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  memberId     String
  subjectToken String

  /// APPROVED · DECLINED
  outcome   String
  amountKes Int?

  /// The vector as it stood at `at`. Frozen, never recomputed.
  features          Json
  featureSetVersion String
  modelVersion      String
  score             Int?

  /// Set once the performance window closes.
  /// REPAID · DEFAULTED · IMMATURE
  label       String?
  labelledAt  DateTime?
  /// OWN_BOOK — we lent and observed the outcome ourselves.
  /// ECOSYSTEM — we DECLINED, another member lent, and we observed theirs.
  ///             This is reject inference with ground truth instead of a guess.
  labelSource String?
  labelMemberCode String?

  @@index([memberId, at])
  @@index([subjectToken])
  @@index([label])
  @@index([outcome, label])
}

// ── Scoring ──────────────────────────────────────────────────────────────────

/// A trained model. Versioned, with the metrics it earned on held-out data.
///
/// Promotion is a status change on a row, not a deploy. That matters: a model
/// that can only be rolled back by shipping code will not be rolled back at
/// 2am when its reason codes start looking wrong.
model ModelVersion {
  id        String   @id @default(cuid())
  version   String   @unique
  algorithm String
  trainedAt DateTime @default(now())

  /// The feature set this was trained against. A model scored with a different
  /// feature set version is scoring on inputs it never saw.
  featureSetVersion String

  /// Learned parameters — coefficients, or the tree ensemble.
  params  Json
  /// AUC, KS, Gini, sample sizes, base rate.
  metrics Json

  /// CHAMPION — decides. CHALLENGER — shadow-scores only. RETIRED.
  status String @default("CHALLENGER")

  trainedOnRows Int
  trainStart    DateTime
  trainEnd      DateTime
  testStart     DateTime
  testEnd       DateTime

  shadowScores ShadowScore[]

  @@index([status])
}

/// A challenger's opinion on a decision the champion already made.
///
/// Challengers score live traffic without deciding anything. Promotion happens
/// only when a challenger beats the champion on a held-out window it has never
/// been trained on — never on backtest alone, because a backtest is a claim
/// about the past and a shadow score is a claim about now.
model ShadowScore {
  id             String   @id @default(cuid())
  decisionId     String
  modelVersionId String
  score          Int
  probability    Float
  at             DateTime @default(now())

  modelVersion ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)

  @@unique([decisionId, modelVersionId])
  @@index([modelVersionId])
}

// ── Onboarding & governance ──────────────────────────────────────────────────

/// A prospective member's application to join.
///
/// Self-service on purpose. The founding cohort was admitted by hand, which is
/// fine for three and impossible for thirty — and a network that only its
/// operator can add members to is not a network, it is a customer list.
model MemberApplication {
  id           String   @id @default(cuid())
  submittedAt  DateTime @default(now())

  organisation String
  contactName  String
  contactEmail String
  /// Where their book lives, so the node can be placed.
  sourceHost     String?
  sourceDatabase String?
  sourceEntityId Int?

  /// Self-declared, verified during the shadow period against what they
  /// actually publish. A claim is not evidence.
  claimedBorrowers Int @default(0)
  claimedLoans     Int @default(0)

  /// Ed25519 public key, hex. Registered by signing the application WITH it,
  /// which proves possession of the private half rather than merely knowledge
  /// of a string someone could have copied.
  publicKey String?

  /// SUBMITTED · KEY_REGISTERED · ADMITTED · REJECTED · WITHDRAWN
  status       String  @default("SUBMITTED")
  decidedAt    DateTime?
  decidedBy    String?
  decisionNote String?

  /// Set when admission creates the Member row.
  memberId String?

  @@index([status, submittedAt])
}

/// An admission, suspension or readmission, and who decided it.
///
/// BirgenAI operates the Interchange while also selling lending software to some
/// members. A competitor will name that conflict in the first meeting, and the
/// answer cannot be "trust us" — it has to be a record of who decided what, on
/// what grounds, visible to every member.
model GovernanceAction {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  /// ADMIT · REJECT · SUSPEND · REINSTATE · PROMOTE_FROM_SHADOW
  action    String
  memberCode String?
  applicationId String?
  /// The governing body member or operator who decided.
  decidedBy String
  rationale String

  @@index([at])
  @@index([memberCode])
}

// ── Operators ────────────────────────────────────────────────────────────────
//
// WHO IS SITTING AT THE CONSOLE, as distinct from WHICH MEMBER they act for.
//
// Sprint 1 conflated the two: a session cookie held a member code, and the gate
// granted it to anyone who typed four digits. That is two separate holes — the
// console had no notion of a person, and the cookie was an unsigned string a
// browser could simply set. Both are closed here.
//
// A SUPER_ADMIN has `memberId = null` on purpose. Every other operator is scoped
// to exactly one member and can never read across the boundary that
// Member.sourceEntityId exists to defend; the platform operator sits ABOVE that
// boundary, which is precisely why the role is separate and separately audited.
//
// ⚠ ACCESS CODES ARE LOW-ENTROPY BY DESIGN — the gate asks for four digits, so
// there are 10,000 of them. The hash is therefore not the control that matters:
// LOCKOUT is. See lib/operator.ts, which locks an operator after
// MAX_FAILED_ATTEMPTS and refuses code login entirely in production unless it
// has been explicitly, deliberately enabled.

enum OperatorRole {
  SUPER_ADMIN // BirgenAI platform operator — every right, above every member
  MEMBER_ADMIN // administers one member: keys, subscriptions, its own operators
  ANALYST // queries and reads on behalf of one member
  AUDITOR // read-only; audit, log and governance surfaces
}

enum OperatorStatus {
  ACTIVE
  DISABLED
}

/// A human who may open the console.
model Operator {
  id   String       @id @default(cuid())
  name String
  role OperatorRole @default(ANALYST)

  /// Null ⇒ platform operator, not scoped to any single member.
  memberId String?

  /// scrypt(code, codeSalt). The plaintext code is never stored, never logged
  /// and never returned by any route.
  codeHash String
  codeSalt String

  /// Grants BEYOND the role's defaults. "*" means every right there is and is
  /// only ever set on SUPER_ADMIN. See lib/rights.ts.
  rights String[] @default([])

  status OperatorStatus @default(ACTIVE)

  // ── Lockout — the control that actually protects a four-digit code ─────────
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([memberId])
}

/// Every console sign-in attempt, successful or not.
///
/// Separate from AuditEntry, which records EXCHANGE calls. Conflating "someone
/// opened the console" with "a member queried a borrower" would make both
/// harder to read, and only one of them is a data-protection event.
model OperatorAudit {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  operatorId String?
  /// SIGN_IN · SIGN_IN_REFUSED · LOCKED · SIGN_OUT · CODE_ROTATED · CREATED
  action     String
  /// Never the code, never a hash of it — just why it failed.
  detail     String?
  ip         String?

  @@index([at])
  @@index([operatorId, at])
}
