# Local development only. Real Postgres via `npx prisma dev -d -n interchange`.
# Gitignored — never put a member credential or an ecosystem secret in here.
DATABASE_URL="postgres://USER:PASS@HOST:PORT/DB"
DIRECT_URL="postgres://USER:PASS@HOST:PORT/DB"

# The OPRF ecosystem secret lives in the Registry only, and never in this file
# outside local development. Sprint 2 moves it behind the token service.
INTERCHANGE_OPRF_DEV_SECRET="set-me"

# Version of the consent wording currently being presented to borrowers.
CONSENT_WORDING_VERSION="2026-08-1.0"

INTERCHANGE_OPRF_KEY="set-me — generate with: npx tsx scripts/generate-keys.ts"

# ── Console sessions (Sprint 2) ──────────────────────────────────────────────
# HMAC key for the signed console session cookie. Generate: npm run keys:session
# Rotating it signs everyone out and nothing more — deliberately unlike the OPRF
# key, which re-tokenises every borrower in the ecosystem.
INTERCHANGE_SESSION_SECRET="set-me — at least 32 characters"

# The four-digit operator access code is refused in production unless this is
# "1". The production door is the member certificate (Ed25519) at /api/session.
INTERCHANGE_ALLOW_CODE_LOGIN="0"

# Dev-only: opens the console as a member with no credential at all.
INTERCHANGE_DEV_OPEN_CONSOLE="0"
